---
// Cómo funciona: 4 pasos + diagrama de la torre que resalta la parte de cada paso
// a medida que el paso pasa por el centro de la pantalla (o al pasar el mouse).
import { Icon } from 'astro-icon/components';

const pasos = [
  {
    icono: 'ph:drop',
    titulo: 'Prepara el agua',
    texto: 'Llena el tanque de la base con agua y agrega los nutrientes. Eso es todo lo que tus plantas necesitan.',
  },
  {
    icono: 'ph:plant',
    titulo: 'Siembra y conecta',
    texto: 'Ubica tus plántulas en los espacios de la torre y conéctala a la corriente. No necesitas tierra.',
  },
  {
    icono: 'ph:arrows-clockwise',
    titulo: 'Se riega sola',
    texto: 'La bomba lleva el agua con nutrientes hasta las raíces en ciclos automáticos de encendido y apagado.',
  },
  {
    icono: 'ph:device-mobile',
    titulo: 'Ajusta desde tu celular',
    texto: 'Conéctate a la torre por Bluetooth para ver su estado y cambiar los tiempos de riego cuando quieras.',
  },
];

// Macetas del diagrama: lado, altura (y) — alternadas a izquierda y derecha
const macetas = [
  { lado: -1, y: 112 },
  { lado: 1, y: 158 },
  { lado: -1, y: 204 },
  { lado: 1, y: 250 },
  { lado: -1, y: 296 },
  { lado: 1, y: 334 },
];

// Gotas de niebla dentro de la torre (valores fijos)
const niebla = Array.from({ length: 9 }, (_, i) => ({
  x: 164 + ((i * 11) % 32),
  delay: -((i * 0.47) % 2.4),
}));
---

<section id="como-funciona" class="seccion relative overflow-x-clip bg-verde text-crema">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 -left-40 size-[34rem] rounded-full bg-verde-700/40 blur-3xl"></div>
  </div>

  <div class="contenedor relative">
    <div data-revelar class="max-w-2xl">
      <span class="eyebrow text-hoja">
        <Icon name="ph:gear-six" class="size-4" /> Cómo funciona
      </span>
      <h2 class="mt-4 text-4xl leading-[1.05] font-semibold sm:text-6xl">
        Cultivar nunca fue <em class="font-normal text-hoja">tan sencillo.</em>
      </h2>
      <p class="mt-5 text-lg text-crema/75">Sin tierra y sin regar a mano. Así es tener una torre GROWA en casa.</p>
    </div>

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-2 lg:gap-20">
      <!-- Diagrama -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div
          data-revelar
          class="relative mx-auto aspect-[360/460] w-full max-w-[17rem] rounded-[2.5rem] sm:max-w-sm bg-verde-950/40 p-6 ring-1 ring-crema/10"
        >
          <svg id="diagrama" viewBox="0 0 360 460" class="size-full" role="img" aria-labelledby="diagrama-titulo">
            <title id="diagrama-titulo">
              Diagrama de la torre: tanque con agua y nutrientes en la base, bomba que sube el agua por el
              centro, plantas en las macetas y celular conectado por Bluetooth.
            </title>

            <!-- Paso 2: cable y enchufe -->
            <g class="parte" data-parte="2">
              <path d="M92 414 C62 414 58 440 34 440" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.6"></path>
              <rect x="14" y="430" width="20" height="20" rx="5" fill="currentColor"></rect>
              <path d="M18 436h-6M18 444h-6" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </g>

            <!-- Paso 1: tanque con agua -->
            <g class="parte" data-parte="1">
              <rect x="90" y="368" width="180" height="70" rx="20" fill="var(--color-verde-950)" stroke="currentColor" stroke-width="2.5"></rect>
              <path class="ondas" d="M100 396 q10 -6 20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 V428 H100Z" fill="var(--color-agua)" opacity="0.85"></path>
            </g>

            <!-- Torre -->
            <rect x="146" y="70" width="68" height="300" rx="28" fill="rgb(250 237 221 / 0.08)" stroke="currentColor" stroke-width="2.5"></rect>
            <rect x="138" y="56" width="84" height="20" rx="10" fill="currentColor"></rect>

            <!-- Paso 3: bomba, tubo y niebla -->
            <g class="parte" data-parte="3">
              <line class="flujo" x1="180" y1="398" x2="180" y2="84" stroke="var(--color-agua)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="7 9"></line>
              <circle cx="180" cy="404" r="12" fill="var(--color-verde)" stroke="var(--color-agua)" stroke-width="3"></circle>
              {
                niebla.map((g) => (
                  <circle class="niebla" cx={g.x} cy="90" r="2.4" fill="var(--color-agua)" style={`animation-delay:${g.delay}s`} />
                ))
              }
            </g>

            <!-- Paso 2: macetas con plantas -->
            <g class="parte" data-parte="2">
              {
                macetas.map((m) => {
                  const cx = 180 + m.lado * 46;
                  return (
                    <g>
                      <path
                        d={`M${cx - 15} ${m.y} h30 l-5 16 h-20 Z`}
                        fill="currentColor"
                      />
                      <path
                        d={`M${cx} ${m.y + 1} c-14 -3 -18 -15 -12 -24 c7 5 11 13 12 24 Z M${cx} ${m.y + 1} c13 -4 17 -14 10 -22 c-6 5 -10 12 -10 22 Z`}
                        fill="var(--color-hoja)"
                      />
                    </g>
                  );
                })
              }
            </g>

            <!-- Paso 4: celular y Bluetooth -->
            <g class="parte" data-parte="4">
              <path class="onda-bt" d="M262 206 q-12 24 0 48" fill="none" stroke="var(--color-hoja)" stroke-width="3" stroke-linecap="round"></path>
              <path class="onda-bt" d="M250 196 q-20 34 0 68" fill="none" stroke="var(--color-hoja)" stroke-width="3" stroke-linecap="round" style="animation-delay:0.3s"></path>
              <rect x="276" y="176" width="58" height="104" rx="13" fill="var(--color-verde-950)" stroke="currentColor" stroke-width="2.5"></rect>
              <rect x="296" y="183" width="18" height="4" rx="2" fill="currentColor" opacity="0.5"></rect>
              <circle cx="292" cy="210" r="5" fill="var(--color-hoja)"></circle>
              <rect x="302" y="207" width="22" height="6" rx="3" fill="currentColor" opacity="0.7"></rect>
              <rect x="286" y="228" width="38" height="7" rx="3.5" fill="currentColor" opacity="0.2"></rect>
              <rect x="286" y="228" width="14" height="7" rx="3.5" fill="var(--color-hoja)"></rect>
              <rect x="286" y="248" width="38" height="16" rx="8" fill="var(--color-agua)"></rect>
            </g>
          </svg>
        </div>
      </div>

      <!-- Pasos -->
      <ol class="flex flex-col gap-3">
        {
          pasos.map((p, i) => (
            <li
              data-revelar
              data-paso={i + 1}
              style={`--retraso: ${i * 80}ms`}
              class="paso group flex gap-5 rounded-card p-6 ring-1 ring-transparent transition-colors duration-500 sm:p-7"
            >
              <span class="numero grid size-12 shrink-0 place-items-center rounded-2xl bg-crema/8 font-display text-xl font-semibold text-crema/70 ring-1 ring-crema/10 transition-colors duration-500">
                {i + 1}
              </span>
              <div>
                <h3 class="text-xl font-semibold sm:text-2xl">
                  {p.titulo}
                  <Icon name={p.icono} class="ml-1 inline size-5 align-[-0.1em] text-hoja" />
                </h3>
                <p class="mt-2 leading-relaxed text-crema/70">{p.texto}</p>
                {i === pasos.length - 1 && (
                  <a
                    href="/control"
                    class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-hoja underline decoration-hoja/40 underline-offset-4 hover:decoration-hoja"
                  >
                    Ir al panel de control <Icon name="ph:arrow-right" class="size-4" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Resaltado según el paso activo. Solo en escritorio: ahí el diagrama queda fijo
     (sticky) junto a los pasos; en móvil queda arriba y no se vería el cambio. */
  .parte {
    transition: opacity 0.5s ease;
  }
  @media (min-width: 1024px) {
    #diagrama[data-paso] .parte {
      opacity: 0.22;
    }
    #diagrama[data-paso='1'] [data-parte='1'],
    #diagrama[data-paso='2'] [data-parte='2'],
    #diagrama[data-paso='3'] [data-parte='3'],
    #diagrama[data-paso='4'] [data-parte='4'] {
      opacity: 1;
    }
  }

  .paso.activo {
    background: rgb(11 36 11 / 0.45);
    --tw-ring-color: rgb(250 237 221 / 0.1);
  }
  .paso.activo .numero {
    background: var(--color-hoja);
    color: var(--color-verde-950);
  }

  /* Animaciones del diagrama */
  .flujo {
    animation: fluir 1.2s linear infinite;
  }
  @keyframes fluir {
    to { stroke-dashoffset: 32; }
  }
  .niebla {
    animation: caer 2.4s ease-in infinite;
  }
  @keyframes caer {
    0%   { transform: translateY(0); opacity: 0; }
    20%  { opacity: 0.9; }
    100% { transform: translateY(250px); opacity: 0; }
  }
  .ondas {
    animation: oleaje 3s ease-in-out infinite;
  }
  @keyframes oleaje {
    50% { transform: translateX(-8px); }
  }
  .onda-bt {
    animation: senal 1.6s ease-in-out infinite;
  }
  @keyframes senal {
    50% { opacity: 0.25; }
  }
</style>

<script>
  const diagrama = document.getElementById('diagrama');
  const pasos = [...document.querySelectorAll<HTMLElement>('.paso')];

  const activar = (paso: HTMLElement) => {
    pasos.forEach((p) => p.classList.toggle('activo', p === paso));
    diagrama?.setAttribute('data-paso', paso.dataset.paso ?? '');
  };

  // El paso que cruza la franja central de la pantalla es el activo
  const io = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) if (e.isIntersecting) activar(e.target as HTMLElement);
    },
    { rootMargin: '-45% 0px -45% 0px' },
  );
  pasos.forEach((p) => {
    io.observe(p);
    p.addEventListener('mouseenter', () => activar(p));
  });
</script>
