---
// Panel de control de la torre por Bluetooth (Web Bluetooth → ESP32-C3).
// Protocolo y diagnóstico: docs/control-ble.md.
// El firmware nuevo agrega `water`, `state`, `hourUsedSec` y `hourMaxSec`; si no
// llegan (firmware viejo) el panel los deriva u oculta esas filas.
// Los IDs que usa el <script is:inline> del final deben conservarse si cambia el diseño.
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Marca from '../components/Marca.astro';
---

<Base
  title="Controlar mi torre — GROWA"
  description="Panel de riego de la torre GROWA por Bluetooth."
  noindex
  themeColor="#0b240b"
>
  <div class="panel-control">
    <header class="mx-auto flex w-full max-w-[30rem] items-center justify-between px-5 pt-6">
      <a href="/" class="h-9" aria-label="GROWA, ir al sitio">
        <Marca class="h-full text-crema" />
      </a>
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-crema/60 transition hover:text-hoja">
        <Icon name="ph:arrow-left" class="size-4" /> Volver al sitio
      </a>
    </header>

    <main id="contenido" class="app">
      <span class="eyebrow text-hoja"><Icon name="ph:drop" class="size-4" /> Panel de riego</span>
      <h1>Tu torre</h1>
      <p class="subtitle">Mira cómo va el riego y ajusta los tiempos desde aquí.</p>

      <!-- Aviso de compatibilidad (se muestra al cargar si no hay Web Bluetooth) -->
      <div id="avisoCompat" class="aviso-compat" role="alert" hidden>
        <Icon name="ph:warning-circle" class="size-6 shrink-0" />
        <div>
          <strong>Tu navegador no puede conectarse por Bluetooth.</strong>
          <p>
            Abre esta página en <b>Chrome</b> o <b>Edge</b> desde un computador o un celular Android.
            No funciona en iPhone, Safari ni Firefox.
          </p>
        </div>
      </div>

      <!-- Conexión: botón grande sin conexión, barra discreta cuando ya está conectada -->
      <div id="connectBlock">
        <button class="connect-btn" id="connectBtn" type="button">
          <Icon name="ph:bluetooth-connected" class="size-5" />
          <span id="connectText">Conectar con la torre</span>
        </button>
        <p class="conn-note" id="connNote">Activa el Bluetooth y acércate a la torre.</p>
      </div>
      <div class="conn-bar" id="connBar" hidden>
        <span class="conn-dot" aria-hidden="true"></span>
        <span>Conectado a <b id="deviceName">la torre</b></span>
        <button type="button" class="conn-off" id="disconnectBtn">Desconectar</button>
      </div>

      <!-- Estado de la torre -->
      <section class="status-card" id="statusCard" data-state="idle" aria-live="polite">
        <div class="estado">
          <div class="estado-icono" aria-hidden="true">
            <Icon name="ph:bluetooth-slash" class="ico ico-idle" />
            <Icon name="ph:drop-fill" class="ico ico-on" />
            <Icon name="ph:hourglass-medium" class="ico ico-off" />
            <Icon name="ph:drop-slash" class="ico ico-nowater" />
            <Icon name="ph:shield-check" class="ico ico-limit" />
          </div>
          <div class="min-w-0">
            <p class="estado-titulo" id="stateTitle">Sin conexión</p>
            <p class="estado-detalle" id="stateDetail">Conecta la torre para ver cómo va el riego.</p>
          </div>
        </div>

        <!-- Progreso de la fase actual (solo en ON / OFF) -->
        <div class="fase" id="phaseBlock" hidden>
          <div class="fase-fila">
            <span id="phaseLabel">Próximo riego en</span>
            <span class="mono fase-tiempo" id="remainingVal">—:—</span>
          </div>
          <div class="barra" role="presentation"><div class="barra-relleno" id="phaseFill"></div></div>
        </div>

        <dl class="datos" id="dataList" hidden>
          <div class="dato" id="waterRow" hidden>
            <dt>Agua en el tanque</dt>
            <dd><span class="chip" id="waterChip">—</span></dd>
          </div>
          <div class="dato" id="hourRow" hidden>
            <dt>Uso en los últimos 60 minutos</dt>
            <dd class="mono" id="hourVal">—</dd>
            <dd class="dato-barra">
              <div class="barra barra-fina"><div class="barra-relleno" id="hourFill"></div></div>
            </dd>
          </div>
          <div class="dato">
            <dt>Ciclo actual</dt>
            <dd class="mono" id="cycleVal">—</dd>
          </div>
        </dl>
      </section>

      <!-- Configuración -->
      <section class="config-card" id="configCard">
        <h2>Ajustar el riego</h2>
        <p class="hint" id="configHint">Conéctate a la torre para cambiar los tiempos.</p>

        <form id="configForm" novalidate>
          <div class="campos">
            <div class="field">
              <label for="onInput">Riego <span>(bomba encendida)</span></label>
              <div class="input-unidad">
                <input type="number" id="onInput" inputmode="decimal" step="any" min="0" required disabled aria-describedby="onNote" />
                <span>min</span>
              </div>
              <p class="field-note" id="onNote">Entre 5 s y 15 min.</p>
            </div>
            <div class="field">
              <label for="offInput">Descanso <span>(bomba apagada)</span></label>
              <div class="input-unidad">
                <input type="number" id="offInput" inputmode="decimal" step="any" min="0" required disabled aria-describedby="offNote" />
                <span>min</span>
              </div>
              <p class="field-note" id="offNote">Al menos el doble del riego.</p>
            </div>
          </div>
          <button type="button" class="fix-btn" id="fixBtn" hidden></button>

          <p class="resumen" id="summary" hidden></p>

          <button type="submit" class="save-btn" id="saveBtn" disabled>Guardar cambios</button>
        </form>
        <p class="form-message" id="formMessage" role="status"></p>
      </section>

      <p class="ayuda">
        <Icon name="ph:lightbulb" class="size-4 shrink-0" />
        Máximo 20 minutos en una ventana móvil de 60 minutos. El uso no vuelve a cero cada hora.
      </p>
    </main>
  </div>

  <!-- Aviso de compatibilidad al cargar -->
  <script is:inline>
    if (!navigator.bluetooth) {
      document.getElementById('avisoCompat').hidden = false;
      document.getElementById('connectBtn').disabled = true;
      document.getElementById('connNote').textContent = window.isSecureContext
        ? 'Este navegador no soporta Web Bluetooth.'
        : 'Web Bluetooth requiere una conexión segura (HTTPS).';
    }
  </script>

  <!-- Lógica BLE -->
  <script is:inline>
const DEVICE_NAME  = 'TorreHidroponica';
const SERVICE_UUID = '12345678-1234-5678-1234-56789abcdef0';
const STATUS_UUID  = '12345678-1234-5678-1234-56789abcdef1';
const CONFIG_UUID  = '12345678-1234-5678-1234-56789abcdef2';

const MIN_SEC = 5;            // mínimo que acepta el firmware para onSec y offSec
const SAVE_TIMEOUT_MS = 15000; // si la torre no confirma en este tiempo, se avisa

const $ = (id) => document.getElementById(id);
const connectBlock  = $('connectBlock');
const connectBtn    = $('connectBtn');
const connectText   = $('connectText');
const connNote      = $('connNote');
const connBar       = $('connBar');
const deviceName    = $('deviceName');
const disconnectBtn = $('disconnectBtn');
const statusCard    = $('statusCard');
const stateTitle    = $('stateTitle');
const stateDetail   = $('stateDetail');
const phaseBlock    = $('phaseBlock');
const phaseLabel    = $('phaseLabel');
const remainingVal  = $('remainingVal');
const phaseFill     = $('phaseFill');
const dataList      = $('dataList');
const waterRow      = $('waterRow');
const waterChip     = $('waterChip');
const hourRow       = $('hourRow');
const hourVal       = $('hourVal');
const hourFill      = $('hourFill');
const cycleVal      = $('cycleVal');
const configHint    = $('configHint');
const configForm    = $('configForm');
const onInput       = $('onInput');
const offInput      = $('offInput');
const onNote        = $('onNote');
const offNote       = $('offNote');
const fixBtn        = $('fixBtn');
const summary       = $('summary');
const saveBtn       = $('saveBtn');
const formMessage   = $('formMessage');

let device = null, statusChar = null, configChar = null;
let status = null;          // último estado recibido (normalizado)
let localRemaining = 0;     // cuenta regresiva local entre notificaciones
let tickHandle = null;
let pendingSave = null;     // { onSec, offSec, timer } mientras se espera confirmación
let manualDisconnect = false;
let zeroRequested = false;
let receivedAt = null, deadline = null, backupHandle = null;
let connectedAt = null, lastReadAt = -Infinity;
let generation = 0, readPending = false, gattQueue = Promise.resolve();
const diagnostics = { lastValidAt: null, validUpdates: 0, lastValidBytes: null, lastMessageBytes: 0, lastValueChangedBytes: null, lastReadBytes: null, lastReadError: null, lastParseError: null, parseErrors: 0, readErrors: 0 };
// Solo telemetría del transporte; no se registran contenidos ni datos personales.
window.growaBleDiagnostics = diagnostics;
function enqueueGatt(operation) {
  const session = generation;
  const result = gattQueue.then(() => {
    if (session !== generation) throw new Error('Sesión BLE terminada');
    return operation();
  });
  gattQueue = result.catch(() => {});
  return result;
}
function receive(value, source = 'valuechanged') {
  diagnostics.lastMessageBytes = value.byteLength;
  diagnostics[source === 'read' ? 'lastReadBytes' : 'lastValueChangedBytes'] = value.byteLength;
  try {
    const raw = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(value));
    applyStatus(raw);
    diagnostics.lastValidBytes = value.byteLength;
    return true;
  } catch (error) {
    diagnostics.parseErrors++;
    diagnostics.lastParseError = { at: new Date().toISOString(), source, bytes: value.byteLength, kind: error.name };
    console.warn('[BLE] Estado inválido', diagnostics.lastParseError);
    return false;
  }
}
async function requestStatus() {
  if (!statusChar || readPending || performance.now() - lastReadAt < 1500) return;
  lastReadAt = performance.now();
  readPending = true;
  const characteristic = statusChar, session = generation;
  try {
    const value = await enqueueGatt(() => characteristic.readValue());
    if (session === generation) receive(value, 'read');
  } catch (error) {
    if (session === generation) {
      diagnostics.readErrors++;
      diagnostics.lastReadError = { at: new Date().toISOString(), kind: error.name };
      console.warn('[BLE] Falló READ', error.message);
    }
  } finally {
    if (session === generation) readPending = false;
  }
}
function cleanupTransport() {
  generation++;
  if (statusChar) statusChar.removeEventListener('characteristicvaluechanged', handleNotification);
  clearInterval(tickHandle);
  clearInterval(backupHandle);
  tickHandle = backupHandle = null;
  readPending = false;
  receivedAt = deadline = connectedAt = null;
  lastReadAt = -Infinity;
  gattQueue = Promise.resolve();
}


// ---------- Formato ----------

function fmtMinSec(totalSec) {
  totalSec = Math.max(0, Math.round(totalSec));
  const m = Math.floor(totalSec / 60);
  const s = totalSec % 60;
  return m + ':' + String(s).padStart(2, '0');
}

// Minutos legibles en español: 2,5 · 15 · 0,08
function fmtMinutes(sec) {
  return (sec / 60).toLocaleString('es', { maximumFractionDigits: 2 });
}

function setFormMessage(text, kind) {
  formMessage.textContent = text || '';
  formMessage.className = 'form-message' + (kind ? ' ' + kind : '');
}

// Barra de progreso: sin animación cuando retrocede (cambio de fase)
function setFill(el, ratio) {
  const pct = Math.min(100, Math.max(0, ratio * 100));
  const prev = parseFloat(el.dataset.pct || '0');
  if (pct < prev) {
    el.style.transition = 'none';
    el.style.width = pct + '%';
    void el.offsetWidth;
    el.style.transition = '';
  } else {
    el.style.width = pct + '%';
  }
  el.dataset.pct = String(pct);
}

// ---------- Estado ----------

// Compatibilidad con firmware viejo: si falta `state` se deriva de `pump`;
// los demás campos nuevos quedan en null y sus filas se ocultan.
function normalize(data) {
  const num = (v) => (typeof v === 'number' && isFinite(v) ? v : null);
  if (!data || typeof data !== 'object' || Array.isArray(data) ||
      ![0, 1].includes(data.pump) ||
      (data.state !== undefined && !['ON', 'OFF', 'NO_WATER', 'HOUR_LIMIT'].includes(data.state)) ||
      !Number.isFinite(data.remainingSec) || data.remainingSec < 0) {
    throw new Error('Campos de estado inválidos');
  }
  const pumpOn = data.pump === 1;
  const known = ['ON', 'OFF', 'NO_WATER', 'HOUR_LIMIT'];
  return {
    pumpOn,
    configPending: data.configPending === true || data.configPending === 1,
    recoveryRemainingSec: num(data.recoveryRemainingSec) ?? 0,
    protectionWaitSec: num(data.protectionWaitSec),
    nextWateringSec: num(data.nextWateringSec),
    state: known.includes(data.state) ? data.state : (pumpOn ? 'ON' : 'OFF'),
    onSec: num(data.onSec),
    offSec: num(data.offSec),
    maxOnSec: num(data.maxOnSec),
    remainingSec: num(data.remainingSec) ?? 0,
    water: data.water === 0 || data.water === 1 ? data.water : null,
    hourUsedSec: num(data.hourUsedSec) ?? (num(data.hourUsedMs) === null ? null : Math.floor(data.hourUsedMs / 1000)),
    hourMaxSec: num(data.hourMaxSec),
    error: typeof data.error === 'string' && data.error ? data.error : null,
  };
}

function stateTexts(s) {
  switch (s.state) {
    case 'ON':
      return ['Regando', 'La bomba está encendida.'];
    case 'OFF':
      return ['En descanso', s.nextWateringSec === null ? 'La bomba está apagada. Esperando estimación de la torre.' : 'La bomba descansa hasta el próximo riego.'];
    case 'NO_WATER':
      return s.water === 1
        ? ['Falta de agua', 'Agua detectada. El riego se reanuda en unos segundos.']
        : ['Falta de agua', 'Riego detenido. Rellena el tanque y el riego se reanudará solo.'];
    case 'HOUR_LIMIT': {
      const max = s.hourMaxSec ? fmtMinutes(s.hourMaxSec) + ' min' : 'su límite';
      return ['Pausa de protección', 'Espera disponibilidad en la ventana móvil para el siguiente riego (máximo ' + max + ').'];
    }
  }
}

function phaseTotal() {
  if (!status) return 0;
  return (status.state === 'ON' ? status.onSec : status.offSec) || 0;
}

function renderPhase() {
  if (!status) return;
  const age = receivedAt === null ? Infinity : performance.now() - receivedAt;
  const stale = age > 8000;
  const expired = deadline !== null && performance.now() >= deadline;
  const total = phaseTotal();
  const active = deadline !== null && !stale && !expired;
  phaseBlock.hidden = !active;
  if (stale || expired) {
    statusCard.dataset.state = 'idle';
    stateTitle.textContent = stale ? 'Datos desactualizados' : 'Actualizando estado…';
    stateDetail.textContent = 'Esperando confirmación de la torre. El riego funciona de forma autónoma.';
    return;
  }
  if (!active) return;
  localRemaining = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));
  phaseLabel.textContent = status.recoveryRemainingSec > 0 ? 'Espera tras reinicio' : status.state === 'HOUR_LIMIT' ? 'Espera estimada' : status.state === 'ON' ? 'Se apaga en' : 'Próximo riego estimado en';
  remainingVal.textContent = fmtMinSec(localRemaining);
  setFill(phaseFill, total > 0 ? 1 - Math.min(localRemaining, total) / total : 0);
}

function renderStatus() {
  const s = status;
  if (!s) {
    if (connectedAt !== null && performance.now() - connectedAt > 8000) {
      stateTitle.textContent = 'Datos desactualizados';
      stateDetail.textContent = 'No se ha recibido un estado válido de la torre.';
    }
    return;
  }
  if (deadline !== null) localRemaining = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));
  statusCard.dataset.state = s.state;
  const [title, detail] = stateTexts(s);
  stateTitle.textContent = title;
  stateDetail.textContent = detail + (s.recoveryRemainingSec > 0 ? ' Espera tras reinicio: ' + fmtMinSec(localRemaining) + '.' : '');

  renderPhase();
  dataList.hidden = false;

  waterRow.hidden = s.water === null;
  if (s.water !== null) {
    waterChip.textContent = s.water ? 'Con agua' : 'Sin agua';
    waterChip.className = 'chip ' + (s.water ? 'chip-ok' : 'chip-alerta');
  }

  const hasHour = s.hourUsedSec !== null && s.hourMaxSec > 0;
  hourRow.hidden = !hasHour;
  if (hasHour) {
    // El uso es el reportado por la placa; no se incrementa localmente.
    hourVal.textContent = fmtMinSec(s.hourUsedSec) + ' de ' + fmtMinSec(s.hourMaxSec);
    const ratio = s.hourUsedSec / s.hourMaxSec;
    setFill(hourFill, ratio);
    hourFill.classList.toggle('lleno', ratio >= 0.9 || s.state === 'HOUR_LIMIT');
  }

  cycleVal.textContent = s.onSec !== null && s.offSec !== null
    ? 'riega ' + fmtMinSec(s.onSec) + ' · descansa ' + fmtMinSec(s.offSec)
    : '—';
}

function restartTicker() {
  if (tickHandle) clearInterval(tickHandle);
  tickHandle = setInterval(() => {
    renderStatus();
    if (deadline !== null && performance.now() >= deadline && !zeroRequested) {
      zeroRequested = true;
      requestStatus();
    }
  }, 1000);
}

function applyStatus(raw) {
  status = normalize(raw);
  zeroRequested = false;
  receivedAt = performance.now();
  diagnostics.lastValidAt = new Date().toISOString();
  diagnostics.validUpdates++;
  const remaining = status.recoveryRemainingSec > 0 ? status.recoveryRemainingSec
    : status.state === 'HOUR_LIMIT' ? (status.protectionWaitSec ?? status.remainingSec)
    : status.state === 'NO_WATER' ? null
    : status.state === 'OFF' && raw.nextWateringSec === null ? null
    : status.state === 'OFF' ? (status.nextWateringSec ?? status.remainingSec) : status.remainingSec;
  localRemaining = remaining ?? 0;
  deadline = remaining === null ? null : receivedAt + remaining * 1000;
  renderStatus();
  restartTicker();

  if (!onInput.dataset.userEdited && status.onSec !== null) onInput.value = String(status.onSec / 60);
  if (!offInput.dataset.userEdited && status.offSec !== null) offInput.value = String(status.offSec / 60);

  if (status.error) {
    clearPending();
    setFormMessage('Rechazada: ' + status.error, 'error');
  } else if (pendingSave && status.onSec === pendingSave.onSec && status.offSec === pendingSave.offSec && !status.configPending) {
    // Conservar ediciones hechas mientras se aplicaba la solicitud anterior.
    if (Math.abs(Number(onInput.value) * 60 - pendingSave.onSec) < 1e-9) delete onInput.dataset.userEdited;
    if (Math.abs(Number(offInput.value) * 60 - pendingSave.offSec) < 1e-9) delete offInput.dataset.userEdited;
    clearPending();
    setFormMessage('Aplicada: cambios confirmados por la torre.', 'ok');
  }
  if (pendingSave && status.configPending) {
    clearTimeout(pendingSave.timer);
    setFormMessage('Pendiente de aplicar: la torre espera a que la bomba esté apagada.', '');
  }
  updateForm();
}

function handleNotification(event) {
  // No concatenar: el protocolo no define fragmentos ni identificadores.
  if (event.target !== statusChar) return;
  if (!receive(event.target.value)) requestStatus();
}

// ---------- Formulario ----------

function validate() {
  const r = { onSec: null, offSec: null, onErr: '', offErr: '', fixOff: null };
  const maxOn = Math.min(900, (status && status.maxOnSec) || 900);
  const onMin = Number(onInput.value);
  const offMin = Number(offInput.value);

  if (!(onMin > 0)) {
    r.onErr = 'Escribe cuántos minutos riega.';
  } else {
    r.onSec = onMin * 60;
    if (Math.abs(r.onSec - Math.round(r.onSec)) < 1e-9) r.onSec = Math.round(r.onSec);
    if (!Number.isInteger(r.onSec)) r.onErr = 'Usa segundos enteros.';
    if (r.onSec < MIN_SEC) r.onErr = 'Mínimo 5 segundos (0,1 min).';
    else if (maxOn && r.onSec > maxOn) r.onErr = 'Máximo ' + fmtMinutes(maxOn) + ' min: es el límite de la bomba.';
  }

  if (!(offMin > 0)) {
    r.offErr = 'Escribe cuántos minutos descansa.';
  } else {
    r.offSec = offMin * 60;
    if (Math.abs(r.offSec - Math.round(r.offSec)) < 1e-9) r.offSec = Math.round(r.offSec);
    if (!Number.isInteger(r.offSec)) r.offErr = 'Usa segundos enteros.';
    if (r.offSec < MIN_SEC) r.offErr = 'Mínimo 5 segundos (0,1 min).';
    else if (r.offSec > 86400) r.offErr = 'Máximo 86400 segundos (1440 min).';
    else if (!r.onErr && r.offSec < 2 * r.onSec) {
      r.offErr = 'Debe ser al menos el doble del riego: ' + fmtMinutes(2 * r.onSec) + ' min o más.';
      r.fixOff = 2 * r.onSec;
    }
  }
  r.ok = !r.onErr && !r.offErr;
  return r;
}

function setNote(el, input, error, fallback) {
  // Solo se marca en rojo si la persona ya escribió en ese campo
  const show = error && input.dataset.userEdited;
  el.textContent = show ? error : fallback;
  el.classList.toggle('error', !!show);
  input.setAttribute('aria-invalid', show ? 'true' : 'false');
}

function updateForm() {
  const connected = !!configChar;
  const v = validate();
  const maxOn = Math.min(900, (status && status.maxOnSec) || 900);

  setNote(onNote, onInput, v.onErr, maxOn ? 'Entre 5 s y ' + fmtMinutes(maxOn) + ' min.' : 'Mínimo 5 s.');
  setNote(offNote, offInput, v.offErr,
    v.onSec >= MIN_SEC ? 'Al menos el doble del riego (' + fmtMinutes(2 * v.onSec) + ' min).' : 'Al menos el doble del riego.');

  const showFix = connected && v.fixOff && offInput.dataset.userEdited;
  fixBtn.hidden = !showFix;
  if (showFix) fixBtn.textContent = 'Usar ' + fmtMinutes(v.fixOff) + ' min de descanso';

  summary.hidden = !(connected && v.ok);
  if (v.ok) {
    const perHour = Math.round((v.onSec / (v.onSec + v.offSec)) * 60);
    summary.innerHTML = 'Regará <b>' + fmtMinSec(v.onSec) + '</b> y descansará <b>' + fmtMinSec(v.offSec) +
      '</b>: unos <b>' + perHour + ' min</b> de riego por hora.';
  }

  const changed = status && (v.onSec !== status.onSec || v.offSec !== status.offSec);
  saveBtn.disabled = !(connected && v.ok && changed && !pendingSave);
  saveBtn.textContent = pendingSave ? 'Guardando…' : (connected && v.ok && !changed ? 'Sin cambios' : 'Guardar cambios');
}

function clearPending() {
  if (pendingSave) clearTimeout(pendingSave.timer);
  pendingSave = null;
}

function markEdited(input) {
  input.dataset.userEdited = '1';
  if (formMessage.classList.contains('ok')) setFormMessage('', '');
  updateForm();
}

onInput.addEventListener('input', () => markEdited(onInput));
offInput.addEventListener('input', () => markEdited(offInput));

fixBtn.addEventListener('click', () => {
  const v = validate();
  if (!v.fixOff) return;
  // Mantener la precisión necesaria para representar segundos enteros.
  offInput.value = String(v.fixOff / 60);
  markEdited(offInput);
  offInput.focus();
});

configForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!configChar || pendingSave) return;

  onInput.dataset.userEdited = '1';
  offInput.dataset.userEdited = '1';
  const v = validate();
  if (!v.ok) {
    updateForm();
    setFormMessage('Revisa los tiempos marcados en rojo.', 'error');
    return;
  }

  const session = generation;
  pendingSave = {
    onSec: v.onSec,
    offSec: v.offSec,
    timer: setTimeout(() => {
      clearPending();
      setFormMessage('La torre no confirmó el cambio. Intenta de nuevo.', 'error');
      updateForm();
    }, SAVE_TIMEOUT_MS),
  };
  setFormMessage('Enviando…', '');
  updateForm();

  try {
    const payload = JSON.stringify({ onSec: v.onSec, offSec: v.offSec });
    const characteristic = configChar;
    await enqueueGatt(() => characteristic.writeValue(new TextEncoder().encode(payload)));
    if (session !== generation) return;
    if (pendingSave) setFormMessage('Pendiente de aplicar: esperando confirmación de la torre.', '');
    requestStatus();
  } catch (err) {
    if (session !== generation) return;
    clearPending();
    setFormMessage('No se pudo enviar: ' + err.message, 'error');
    updateForm();
  }
});

// ---------- Conexión ----------

function setConnectedUI(connected) {
  connectBlock.hidden = connected;
  connBar.hidden = !connected;
  onInput.disabled = !connected;
  offInput.disabled = !connected;
  configHint.hidden = connected;
}

function onDisconnected() {
  if (device) device.removeEventListener('gattserverdisconnected', onDisconnected);
  cleanupTransport();
  clearPending();
  statusChar = configChar = null;
  status = null;
  setConnectedUI(false);
  connectBtn.disabled = false;
  connectText.textContent = 'Conectar con la torre';

  statusCard.dataset.state = 'idle';
  stateTitle.textContent = 'Sin conexión';
  stateDetail.textContent = manualDisconnect
    ? 'Te desconectaste de la torre. Sigue regando sola.'
    : 'Se perdió la conexión. La torre sigue regando sola; vuelve a conectarte.';
  phaseBlock.hidden = true;
  dataList.hidden = true;
  delete onInput.dataset.userEdited;
  delete offInput.dataset.userEdited;
  setFormMessage('', '');
  updateForm();
  manualDisconnect = false;
}

async function connect() {
  if (!navigator.bluetooth) {
    connNote.textContent = 'Este navegador no soporta Web Bluetooth. Usa Chrome o Edge.';
    return;
  }
  connectBtn.disabled = true;
  connectText.textContent = 'Buscando…';
  try {
    // El nombre va en el advertising y el UUID en el scan response:
    // se filtra por nombre (o servicio) y se pide acceso al servicio.
    device = await navigator.bluetooth.requestDevice({
      filters: [{ name: DEVICE_NAME }, { services: [SERVICE_UUID] }],
      optionalServices: [SERVICE_UUID],
    });
    device.removeEventListener('gattserverdisconnected', onDisconnected);
    device.addEventListener('gattserverdisconnected', onDisconnected);

    connectText.textContent = 'Conectando…';
    cleanupTransport();
    const session = generation;
    const server = await device.gatt.connect();
    if (session !== generation) throw new Error('Conexión interrumpida');
    const service = await server.getPrimaryService(SERVICE_UUID);
    statusChar = await service.getCharacteristic(STATUS_UUID);
    configChar = await service.getCharacteristic(CONFIG_UUID);

    if (session !== generation) throw new Error('Conexión interrumpida');
    statusChar.addEventListener('characteristicvaluechanged', handleNotification);
    await enqueueGatt(() => statusChar.startNotifications());

    if (session !== generation) throw new Error('Conexión interrumpida');
    connectedAt = performance.now();
    deviceName.textContent = device.name || 'la torre';
    setConnectedUI(true);
    setFormMessage('', '');

    if (!status) stateTitle.textContent = 'Actualizando estado…';
    if (status) renderStatus();
    restartTicker();
    backupHandle = setInterval(requestStatus, 5000);
    await requestStatus();
    if (session !== generation) throw new Error('Conexión interrumpida');
  } catch (e) {
    cleanupTransport();
    clearPending();
    status = null;
    statusChar = configChar = null;
    if (device) {
      device.removeEventListener('gattserverdisconnected', onDisconnected);
      if (device.gatt.connected) device.gatt.disconnect();
    }
    setConnectedUI(false);
    statusCard.dataset.state = 'idle';
    stateTitle.textContent = 'Sin conexión';
    stateDetail.textContent = 'No se pudo completar la conexión con la torre.';
    phaseBlock.hidden = dataList.hidden = true;
    connectBtn.disabled = false;
    connectText.textContent = 'Conectar con la torre';
    connNote.textContent = e.name === 'NotFoundError'
      ? 'No elegiste ninguna torre. Toca el botón para intentarlo de nuevo.'
      : 'No se pudo conectar (' + e.message + '). Acércate a la torre e intenta de nuevo.';
  }
}

document.addEventListener('visibilitychange', () => {
  if (!document.hidden && statusChar) {
    if (status) renderStatus();
    requestStatus();
  }
});

connectBtn.addEventListener('click', connect);

disconnectBtn.addEventListener('click', () => {
  if (device && device.gatt.connected) {
    manualDisconnect = true;
    device.gatt.disconnect();
  }
});

updateForm();
</script>
</Base>

